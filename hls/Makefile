VITIS_HLS = vitis_hls
VIVADO = vivado

PROJECT = reduced_vgg.prj
SOLUTION = solution1
TOP_FUNC = reduced_vgg_inference

IP_DIR = $(PROJECT)/$(SOLUTION)/impl/ip
EXPORT_DIR = $(PROJECT)/$(SOLUTION)/impl/export
SYN_REPORT = $(PROJECT)/$(SOLUTION)/syn/report

VIVADO_PRJ = vivado_project
BITSTREAM = $(VIVADO_PRJ)/$(VIVADO_PRJ).runs/impl_1/design_1_wrapper.bit

.PHONY: all clean help csim csynth cosim ip reports sim_gcc bambu yosys

.DEFAULT_GOAL := all

sim_gcc:
	@echo "=========================================="
	@echo "Running Open-Source C++ Simulation (GCC)..."
	@echo "=========================================="
	g++ -std=c++11 -O3 -DNO_HLS tb_conv.cpp tiled_conv.cpp utils.cpp -o sim
ifeq ($(OS),Windows_NT)
	sim.exe
else
	./sim
endif
	@echo "✅ GCC Functional Simulation Complete!"

bambu:
	@echo "=========================================="
	@echo "Running Bambu Open-Source HLS (C++ to Verilog)..."
	@echo "=========================================="
	@echo "NOTE: Run 'make sim_gcc' first to verify functional correctness"
	bambu --top-fname=reduced_vgg_inference --clock-period=15 -I. tiled_conv.cpp utils.cpp -DNO_HLS
	@echo "✅ Open-Source HLS Synthesis Complete (Verilog generated!)"

yosys:
	@echo "=========================================="
	@echo "Running Yosys Open-Source RTL Synthesis..."
	@echo "=========================================="
	@echo "NOTE: Expects 'reduced_vgg_inference.v' generated by 'make bambu' first."
	@if [ ! -f reduced_vgg_inference.v ]; then echo "❌ ERROR: reduced_vgg_inference.v not found. Run 'make bambu' first."; exit 1; fi
	yosys -s synth_xilinx.ys
	@echo "✅ Yosys Open-Source Synthesis Complete!"

all: ip
	@echo "✅ IP package created successfully!"
	@echo "   Location: $(IP_DIR)"

csim:
	@echo "=========================================="
	@echo "Running C Simulation..."
	@echo "=========================================="
	$(VITIS_HLS) -f vitis_hls.tcl csim
	@echo ""
	@echo "✅ C Simulation Complete!"

cosim:
	$(VITIS_HLS) -f vitis_hls.tcl cosim

csynth:
	@echo "=========================================="
	@echo "Running C Synthesis..."
	@echo "=========================================="
	$(VITIS_HLS) -f vitis_hls.tcl csynth
	@echo ""
	@echo "✅ Synthesis Complete!"
	@echo ""
	@$(MAKE) -s reports

ip: csynth
	@echo ""
	@echo "=========================================="
	@echo "IP Package Created!"
	@echo "=========================================="
	@echo "Location: $(IP_DIR)"
	@echo ""
	@echo "To use in Vivado:"
	@echo "  1. Tools → Settings → IP → Repository"
	@echo "  2. Add: $(shell pwd)/$(IP_DIR)"
	@echo ""

reports:
	@echo ""
	@echo "=========================================="
	@echo "📊 SYNTHESIS REPORTS"
	@echo "=========================================="
	@if [ -f "$(SYN_REPORT)/$(TOP_FUNC)_csynth.rpt" ]; then \
		echo ""; \
		echo "--- TIMING ---"; \
		grep -A 5 "Timing" $(SYN_REPORT)/$(TOP_FUNC)_csynth.rpt | head -10; \
		echo ""; \
		echo "--- LATENCY ---"; \
		grep -A 8 "Latency" $(SYN_REPORT)/$(TOP_FUNC)_csynth.rpt | head -15; \
		echo ""; \
		echo "--- RESOURCES ---"; \
		grep -A 12 "Utilization Estimates" $(SYN_REPORT)/$(TOP_FUNC)_csynth.rpt | tail -10; \
		echo ""; \
		echo "Full report: $(SYN_REPORT)/$(TOP_FUNC)_csynth.rpt"; \
	else \
		echo "⚠️  Synthesis report not found. Run 'make csynth' first."; \
	fi
	@echo "=========================================="

clean:
	@echo "Cleaning generated files..."
	rm -rf $(PROJECT)
	rm -rf $(VIVADO_PRJ)
	rm -rf *.log *.jou .Xil
	rm -rf vivado*.str sim sim.exe
	@echo "✅ Clean complete"

help:
	@echo "=========================================="
	@echo "Reduced VGG FPGA Accelerator Makefile"
	@echo "=========================================="
	@echo ""
	@echo "Default HLS Flow (Vitis / Vivado):"
	@echo "  make csim      - Run C simulation using Vitis HLS"
	@echo "  make csynth    - Run C synthesis and show reports"
	@echo "  make cosim     - Synthesize and verify generated RTL with Vitis"
	@echo "  make ip        - Generate IP package for Vivado (default)"
	@echo "  make reports   - Show synthesis reports"
	@echo ""
	@echo "Open-Source Free Toolchain Flow:"
	@echo "  make sim_gcc   - Run C++ simulation using GCC (No Vitis required)"
	@echo "  make bambu     - Run open-source HLS (C++ to Verilog using Bambu)"
	@echo "  make yosys     - Run open-source RTL synthesis using Yosys"
	@echo ""
	@echo "Utilities:"
	@echo "  make clean     - Remove all generated files"
	@echo "  make help      - Show this message"
	@echo ""
	@echo "Quick Start:"
	@echo "  1. make csynth  - Synthesize with Vitis HLS"
	@echo "  2. make sim_gcc - Alternative: Run free C++ simulation with GCC"
